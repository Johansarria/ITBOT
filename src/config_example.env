# Ejemplo de configuración de APIs para SICAR XAI
# Copia este archivo como .env y actualiza con tus claves reales

# =============================================
# CONFIGURACIÓN DE LLMs PARA ANÁLISIS COGNITIVO
# =============================================

# Control maestro para habilitar/deshabilitar LLMs externos
# Esto debe estar en "true" para usar cualquier API externa
ALLOW_EXTERNAL_LLMS=true

# Orden de fallback para las APIs (separado por comas)
# El sistema intentará en este orden hasta que una funcione
LLM_FALLBACK_ORDER=openai,anthropic,zai,grok,local

# -----------------------------------------------------
# OPENAI API
# -----------------------------------------------------
OPENAI_API_KEY=sk-tu-clave-openai-aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------
# ANTHROPIC CLAUDE API
# -----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-tu-clave-anthropic-aqui
ANTHROPIC_MODEL=claude-3-haiku-20240307

# -----------------------------------------------------
# Z.AI API
# -----------------------------------------------------
ZAI_API_KEY=tu-clave-z-ai-aqui
ZAI_API_URL=https://api.z.ai/api/paas/v4

# -----------------------------------------------------
# GROK (X.AI) API
# -----------------------------------------------------
GROK_API_KEY=tu-clave-grok-aqui
GROK_API_URL=https://api.x.ai/v1

# =============================================
# OTRAS CONFIGURACIONES DEL SISTEMA
# =============================================

# Modo de trading (live/testnet)
TRADING_MODE=testnet

# Paper trading (true/false)
PAPER_TRADING=true

# Binance API (solo necesario para trading real)
BINANCE_API_KEY=tu-clave-binance-aqui
BINANCE_API_SECRET=tu-secreto-binance-aqui

# =============================================
# NOTAS IMPORTANTES
# =============================================

# 1. Seguridad: Nunca compartas este archivo con tus claves reales
# 2. Fallback: Si ninguna API externa funciona, el sistema usará análisis local
# 3. Testing: Puedes probar cada API individualmente con el script de prueba
# 4. Límites: Ten en cuenta los límites de cada API según tu plan
{
  "stop_loss_monitor": {
    "check_interval": 30,
    "enable_logging": true,
    "log_level": "INFO",
    "max_log_size_mb": 10
  },
  "risk_management": {
    "max_positions": 2,
    "default_stop_loss_pct": 2.0,
    "default_take_profit_pct": 4.0,
    "emergency_stop_loss_pct": 5.0
  },
  "notifications": {
    "enable_stop_loss_alerts": true,
    "enable_take_profit_alerts": true,
    "enable_error_alerts": true
  }
}
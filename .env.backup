# Nota: este archivo ha sido sanitizado. Rellene los valores reales en su entorno local
# o en un secreto gestionado (no lo comite). Use `.env.example` como plantilla.

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
BINANCE_API_KEY=YOUR_BINANCE_API_KEY_HERE
BINANCE_SECRET_KEY=YOUR_BINANCE_SECRET_KEY_HERE
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=itbot_db
REDIS_HOST=redis
REDIS_PORT=6379
MLFLOW_TRACKING_URI=http://localhost:5000
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here

# Variables adicionales para Docker / Postgres (use las mismas credenciales que DB_*)
POSTGRES_DB=itbot_db
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_herePRODUCTION_MODE=false

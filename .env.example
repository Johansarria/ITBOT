# Configuración de Binance Testnet para SICAR
# Copia este archivo como .env y completa con tus credenciales

# Credenciales de Binance Testnet
# Obtener en: https://testnet.binance.vision/
BINANCE_API_KEY=tu_api_key_aqui
BINANCE_SECRET_KEY=tu_secret_key_aqui

# Configuración de OpenAI (opcional para reportes XAI)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Configuración de Anthropic (opcional para reportes XAI)
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui

# Configuración de trading
TRADING_MODE=testnet  # testnet o live
PAPER_TRADING=true    # true para simulación, false para trading real
SYMBOL=BTCUSDT        # Par de trading
INITIAL_CAPITAL=100000.0  # Capital inicial en USDT

# Configuración de riesgo
RISK_PER_TRADE=0.02   # 2% de riesgo por trade
STOP_LOSS_PCT=0.05    # 5% stop loss
TAKE_PROFIT_PCT=0.10  # 10% take profit
MIN_CONFIDENCE=0.6    # Confianza mínima para operar

# Configuración de análisis
ANALYSIS_INTERVAL=3600  # Análisis cada hora (en segundos)
ENABLE_XAI_REPORTS=true
ENABLE_NEWS_ANALYSIS=true
ENABLE_REGIME_ANALYSIS=true

# Configuración de logs
LOG_LEVEL=INFO
LOG_DECISIONS=true
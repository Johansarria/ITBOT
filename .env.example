# Copia este archivo a .env y completa los valores sensibles
# Ejemplo de variables necesarias para docker-compose

# PostgreSQL
POSTGRES_DB=itbot_db
POSTGRES_USER=itbot_db_prueba
POSTGRES_PASSWORD=changeme_secure_password_here

# Redis (normalmente no hace falta cambiar)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here

# Binance API (si usas trading en vivo)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# MLflow (opcional)
MLFLOW_TRACKING_URI=http://localhost:5000

# Flags
PRODUCTION_MODE=false
DYNAMIC_PAIR_SELECTION_ENABLED=true

# VPS/Production Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8080
FLASK_SECRET_KEY=change_this_secret_key_for_production
FLASK_DEBUG=false

# Analysis and Risk Parameters (can be adjusted)
ANALYSIS_INTERVAL_SECONDS=300
RISK_PER_TRADE_STOP_LOSS_PCT=2.0
RISK_PER_TRADE_TAKE_PROFIT_PCT=4.0
RISK_MAX_CONCURRENT_TRADES=4
RISK_MAX_EXPOSURE_PCT=30.0
RISK_MAX_DAILY_DRAWDOWN_PCT=3.0
DEFAULT_RISK_PERCENTAGE=1.0

# Data and Storage Paths
DATA_PATH=/app/data
LOGS_PATH=/app/logs
STORAGE_PATH=/app/storage

# Banner for web interface (optional)
BANNER_IMAGE_PATH=/app/assets/logo.png

# Copia este archivo a .env y completa los valores sensibles
# Ejemplo de variables necesarias para docker-compose

# PostgreSQL
POSTGRES_DB=itbot_db
POSTGRES_USER=itbot_db_prueba
POSTGRES_PASSWORD=changeme

# Redis (normalmente no hace falta cambiar)
REDIS_HOST=redis
REDIS_PORT=6379

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here

# Binance API (si usas trading en vivo)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# MLflow (opcional)
MLFLOW_TRACKING_URI=http://localhost:5000

# Flags
PRODUCTION_MODE=false
DYNAMIC_PAIR_SELECTION_ENABLED=true

# Ejecución en cTrader (bridge interno)
# Objetivo de ejecución: BINANCE | CTRADER | SIMULATED
EXECUTION_TARGET=CTRADER
# URL interna del servicio web (usada por worker dentro de Docker)
WEB_API_BASE_URL=http://web:8080
# Secreto interno para autenticar pull/ack entre worker y web
INTERNAL_API_SECRET=local-internal-secret

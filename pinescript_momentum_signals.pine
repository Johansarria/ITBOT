//@version=6
// Indicador de Momentum y Señales - Replica la gestión de probabilidades adaptativas
// Basado en la lógica de simulacion_real_binance.py para cálculo de retornos
indicator("ITBOT Momentum Signals", shorttitle="ITBOT-MS", overlay=false)

// === PARÁMETROS DE ENTRADA ===
fast_ma_len = input.int(5, title="Fast MA Length", minval=1)
slow_ma_len = input.int(20, title="Slow MA Length", minval=1)
trend_threshold = input.float(0.1, title="Trend Threshold %", minval=0.01, step=0.01)
base_win_prob = input.float(55.0, title="Base Win Probability %", minval=30.0, maxval=80.0)
volatility_period = input.int(14, title="Volatility Period", minval=5, maxval=50)
show_probabilities = input.bool(true, title="Show Win Probabilities")
show_returns = input.bool(true, title="Show Expected Returns")

// === CÁLCULOS BASE ===
fast_ma = ta.sma(close, fast_ma_len)
slow_ma = ta.sma(close, slow_ma_len)
ma_diff_percent = ((fast_ma - slow_ma) / slow_ma) * 100

// === ANÁLISIS DE TENDENCIA ===
trend_bullish = ma_diff_percent > trend_threshold
trend_bearish = ma_diff_percent < -trend_threshold
trend_neutral = math.abs(ma_diff_percent) <= trend_threshold

// === CÁLCULO DE VOLATILIDAD ===
// Replica el cálculo de volatilidad de las simulaciones
price_returns = ta.change(close) / close[1] * 100
volatility = ta.stdev(price_returns, volatility_period)

// === PROBABILIDADES ADAPTATIVAS ===
// Replica la lógica de adjust_probabilities_based_on_trend()
win_probability = trend_bullish ? base_win_prob + 5.0 :
                  trend_bearish ? base_win_prob - 5.0 :
                  base_win_prob

// Ajuste adicional basado en volatilidad
volatility_adjustment = volatility > 2.0 ? -2.0 : volatility < 0.5 ? 2.0 : 0.0
adjusted_win_prob = math.max(30.0, math.min(80.0, win_probability + volatility_adjustment))

// === CÁLCULO DE RETORNOS ESPERADOS ===
// Replica la lógica de calculate_realistic_return()
base_return_bullish = 1.5
base_return_bearish = 1.2
base_return_neutral = 1.0

expected_return = trend_bullish ? base_return_bullish + (volatility * 0.3) :
                  trend_bearish ? base_return_bearish + (volatility * 0.2) :
                  base_return_neutral + (volatility * 0.1)

// Aplicar distribución gaussiana simulada
random_factor = math.sin(bar_index * 0.1) * 0.3  // Simulación de factor aleatorio
final_return = expected_return + random_factor

// === SEÑALES DE TRADING ===
buy_signal = trend_bullish and not trend_bullish[1] and adjusted_win_prob > 60.0
sell_signal = trend_bearish and not trend_bearish[1] and adjusted_win_prob > 50.0
neutral_signal = trend_neutral and not trend_neutral[1]

// === MOMENTUM SCORE ===
// Combina tendencia, probabilidad y retorno esperado
momentum_score = (ma_diff_percent * 10) + (adjusted_win_prob - 50) + (final_return * 5)

// === VISUALIZACIÓN ===
// Línea de momentum score
plot(momentum_score, title="Momentum Score", color=color.blue, linewidth=2)
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dashed)
hline(20, "Overbought", color=color.red, linestyle=hline.style_dotted)
hline(-20, "Oversold", color=color.green, linestyle=hline.style_dotted)

// Probabilidad de éxito
prob_plot = show_probabilities ? adjusted_win_prob - 50 : na  // Centrado en 0
plot(prob_plot, title="Win Probability (Centered)", color=color.orange, linewidth=1)

// Retorno esperado
return_plot = show_returns ? final_return * 10 : na  // Escalado para visualización
plot(return_plot, title="Expected Return (Scaled)", color=color.purple, linewidth=1)

// Fondo de señales
bgcolor(buy_signal ? color.new(color.green, 90) : 
        sell_signal ? color.new(color.red, 90) : 
        neutral_signal ? color.new(color.yellow, 90) : na)

// === TABLA DE MÉTRICAS ===
if barstate.islast and show_probabilities
    var table metrics_table = table.new(position.bottom_right, 2, 6, 
                                        bgcolor=color.white, border_width=1)
    
    // Encabezados
    table.cell(metrics_table, 0, 0, "Metric", text_color=color.black, bgcolor=color.gray)
    table.cell(metrics_table, 1, 0, "Value", text_color=color.black, bgcolor=color.gray)
    
    // Métricas actuales
    current_trend = trend_bullish ? "BULLISH" : trend_bearish ? "BEARISH" : "NEUTRAL"
    table.cell(metrics_table, 0, 1, "Trend", text_color=color.black)
    table.cell(metrics_table, 1, 1, current_trend, 
               text_color=trend_bullish ? color.green : trend_bearish ? color.red : color.orange)
    
    table.cell(metrics_table, 0, 2, "Win Prob %", text_color=color.black)
    table.cell(metrics_table, 1, 2, str.tostring(adjusted_win_prob, "#.#") + "%", text_color=color.black)
    
    table.cell(metrics_table, 0, 3, "Expected Return %", text_color=color.black)
    table.cell(metrics_table, 1, 3, str.tostring(final_return, "#.##") + "%", text_color=color.black)
    
    table.cell(metrics_table, 0, 4, "Volatility %", text_color=color.black)
    table.cell(metrics_table, 1, 4, str.tostring(volatility, "#.##") + "%", text_color=color.black)
    
    table.cell(metrics_table, 0, 5, "Momentum Score", text_color=color.black)
    table.cell(metrics_table, 1, 5, str.tostring(momentum_score, "#.#"), 
               text_color=momentum_score > 0 ? color.green : color.red)

// === HISTOGRAMA DE SEÑALES ===
signal_strength = buy_signal ? adjusted_win_prob : 
                  sell_signal ? -adjusted_win_prob : 
                  neutral_signal ? 0 : na
                  
plot(signal_strength, title="Signal Strength", style=plot.style_histogram, 
     color=signal_strength > 0 ? color.new(color.green, 50) : 
           signal_strength < 0 ? color.new(color.red, 50) : 
           color.new(color.yellow, 50))

// === ALERTAS AVANZADAS ===
alertcondition(buy_signal, title="ITBOT Strong Buy", 
               message="ITBOT Momentum: STRONG BUY signal - Win Prob: " + str.tostring(adjusted_win_prob, "#.#") + "% | Expected Return: " + str.tostring(final_return, "#.##") + "% | {{ticker}} at {{close}}")
               
alertcondition(sell_signal, title="ITBOT Strong Sell", 
               message="ITBOT Momentum: STRONG SELL signal - Win Prob: " + str.tostring(adjusted_win_prob, "#.#") + "% | Expected Return: " + str.tostring(final_return, "#.##") + "% | {{ticker}} at {{close}}")
               
alertcondition(momentum_score > 30, title="ITBOT High Momentum", 
               message="ITBOT Momentum: HIGH MOMENTUM detected - Score: " + str.tostring(momentum_score, "#.#") + " | {{ticker}} at {{close}}")
               
alertcondition(momentum_score < -30, title="ITBOT Low Momentum", 
               message="ITBOT Momentum: LOW MOMENTUM detected - Score: " + str.tostring(momentum_score, "#.#") + " | {{ticker}} at {{close}}")